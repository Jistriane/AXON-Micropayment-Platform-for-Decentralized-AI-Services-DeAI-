# Gateway
PORT=8080
X402_EXPECTED_TOKEN=
PLATFORM_FEE_BPS=500

# Database (Prisma)
# For development (SQLite):
# DATABASE_URL="file:./dev.db"
# For production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@localhost:5432/axon_gateway?schema=public"
DATABASE_URL="file:./dev.db"

# Stellar Configuration
STELLAR_NETWORK=testnet
STELLAR_SECRET_KEY=
STELLAR_PLATFORM_ACCOUNT=
ENABLE_STELLAR_SETTLEMENT=false
ENABLE_TX_STATUS_LOOKUP=false
HORIZON_URL=https://horizon-testnet.stellar.org
EXTERNAL_MAX_ATTEMPTS=2
EXTERNAL_RETRY_BASE_DELAY_MS=150
EXTERNAL_FAILURE_THRESHOLD=3
EXTERNAL_CIRCUIT_OPEN_MS=10000
INFERENCE_MAX_ATTEMPTS=2
HORIZON_MAX_ATTEMPTS=2
SOROBAN_IDENTITY=axon-admin
SOROBAN_NETWORK=testnet
ENABLE_SOROBAN_SETTLEMENT=false
ENABLE_FACILITATOR_SETTLEMENT=false
FACILITATOR_MODE=optional
FACILITATOR_URL=
FACILITATOR_API_KEY=
FACILITATOR_TIMEOUT_MS=4000
FACILITATOR_MAX_ATTEMPTS=2
FACILITATOR_RELAYER_ID=
FACILITATOR_POLICY_ID=
FACILITATOR_PROVIDER_CONTRACT_ID=
FACILITATOR_NETWORK=testnet
ENFORCE_CONSUMER_AUTH_ONCHAIN=false
MARKETPLACE_CONTRACT_ID=
PAYMENT_ROUTER_CONTRACT_ID=

# External Inference Service
INFERENCE_UPSTREAM_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
INFERENCE_FALLBACK_MODE=disabled
INFERENCE_PROVIDER=gemini
INFERENCE_UPSTREAM_API_KEY=
INFERENCE_TIMEOUT_MS=10000

# Frontend
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8080
NEXT_PUBLIC_X402_TOKEN=
NEXT_PUBLIC_PAYMENT_ROUTER_CONTRACT_ID=
# frontend tx lookup is enabled by default; use false to disable explicitly
NEXT_PUBLIC_ENABLE_TX_STATUS_LOOKUP=true
NEXT_PUBLIC_TX_STATUS_POLL_INTERVAL_MS=2500
NEXT_PUBLIC_TX_STATUS_MAX_POLLS=6
NEXT_PUBLIC_REQUIRE_WALLET=false
NEXT_PUBLIC_REQUIRE_WALLET_SIGNATURE=false
